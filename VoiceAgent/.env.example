# Copy to .env and adjust. .env is git-ignored: never commit real secrets.

# --- Service ---
SERVICE_NAME=awaazai-voiceagent
ENVIRONMENT=development          # development | test | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL

# The port is chosen when starting the server (uvicorn --port 8001), not here.
# The Backend reaches this service via its own VOICE_AGENT_BASE_URL=http://localhost:8001

# --- LLM provider: Gemini (Phase 2) ---
# Get a key from Google AI Studio and put it ONLY in your local .env. Never commit or share it.
# Leave empty to run without Gemini: the service still starts, /health works, /chat answers 503.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=20           # per-request limit for the Gemini call (1-120)
LLM_TEMPERATURE=0.7              # 0 = focused, 2 = very random
LLM_MAX_OUTPUT_TOKENS=512        # keeps spoken replies short

# --- Streaming and concurrency (Phase 3A) ---
# LLM_TIMEOUT_SECONDS above is also the longest wait for the NEXT chunk of a stream, and the longest a slow
# client may take to accept one event before the stream is dropped.
LLM_STREAM_TIMEOUT_SECONDS=60          # longest total time for one streamed answer
LLM_MAX_CONCURRENT_GENERATIONS=8       # simultaneous Gemini calls, shared by /chat and /chat/stream
GENERATION_QUEUE_TIMEOUT_SECONDS=5     # how long a request waits for a free slot before getting 503

# --- Speech-to-text (Phase 3B): Deepgram live streaming ---
# A separate credential from Gemini. Get a key at https://console.deepgram.com and put it ONLY in your local .env.
# Leave empty to run without STT: the service still starts and /stt/stream reports stt_not_configured.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# DEEPGRAM_URL=wss://api.deepgram.com/v1/listen   # must be wss:// (ws:// only for localhost test servers)
# Our language names -> Deepgram language codes. Hinglish has NO documented Deepgram mode: "multi" is Nova-3's
# multilingual code-switching mode (it lists Hindi and English). Test it with YOUR audio; if it misbehaves, try "hi".
DEEPGRAM_LANGUAGE_ENGLISH=en                       # or en-IN for Indian-accented English
DEEPGRAM_LANGUAGE_HINDI=hi
DEEPGRAM_LANGUAGE_HINGLISH=multi
DEEPGRAM_ENDPOINTING_MS=300                        # silence (ms) that ends an utterance
DEEPGRAM_ENDPOINTING_MS_HINGLISH=100               # same, for hinglish (multi): Deepgram recommends 100 for code-switching
STT_CONNECT_TIMEOUT_SECONDS=10
STT_IDLE_TIMEOUT_SECONDS=8                         # no client message for this long ends the stream (max 9)
STT_FINISH_TIMEOUT_SECONDS=10                      # wait for final transcripts after the client sends "end"
STT_SEND_TIMEOUT_SECONDS=10                        # a client that cannot accept an event this fast is dropped
STT_MAX_STREAM_SECONDS=300                         # wall-clock limit for one stream
STT_MAX_AUDIO_SECONDS=120                          # total audio accepted per stream
STT_MAX_CHUNK_BYTES=32768                          # one binary frame (1 s of 16 kHz mono 16-bit PCM)
STT_MAX_CONCURRENT_STREAMS=4
STT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173   # browser origins allowed to connect

# --- Text-to-speech (Phase 3C): streamed as MP3 (audio/mpeg) by the provider chosen here ---
TTS_PROVIDER=deepgram                              # deepgram | sarvam. Without the chosen provider's key, /tts/stream reports tts_not_configured.
# Deepgram Aura reuses DEEPGRAM_API_KEY above. It documents NO Hindi voice and no Indian-accent English.
# For natural Hindi and Hinglish, use TTS_PROVIDER=sarvam and set SARVAM_API_KEY below.
DEEPGRAM_TTS_MODEL=aura-2-thalia-en                # default voice, e.g. aura-2-<name>-en
# DEEPGRAM_TTS_VOICES=aura-2-zeus-en,aura-2-luna-en   # extra voices a client may request (comma-separated allowlist)
# DEEPGRAM_TTS_URL=https://api.deepgram.com/v1/speak  # must be https:// (http:// only for localhost test servers)
DEEPGRAM_TTS_BIT_RATE=48000                        # 32000 or 48000
TTS_TIMEOUT_SECONDS=15                             # connect, and the wait for each next audio chunk
TTS_STREAM_TIMEOUT_SECONDS=60                      # whole synthesis
TTS_SEND_TIMEOUT_SECONDS=10                        # a client that cannot accept audio this fast is dropped
TTS_MAX_TEXT_CHARS=2000                            # 1-2000 (2000 is Deepgram's own limit)
TTS_MAX_CONCURRENT_REQUESTS=4                      # separate from the Gemini and STT limits
TTS_QUEUE_TIMEOUT_SECONDS=2                        # how long a request waits for a free slot before 503

# --- Sarvam AI Bulbul TTS (used when TTS_PROVIDER=sarvam): https://docs.sarvam.ai ---
# Get a key at https://dashboard.sarvam.ai and put it ONLY in your local .env. Never commit or share it.
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v4-flash                   # bulbul:v2 | bulbul:v3 | bulbul:v4-flash (Sarvam's recommended)
# SARVAM_TTS_URL=https://api.sarvam.ai/text-to-speech/stream   # must be https:// (http:// only for localhost test servers)
# Our language names -> Sarvam BCP-47 codes. Sarvam does not say which code its code-mixed (enhi) voices expect:
# hi-IN is the Hinglish default. Change it if listening tests say otherwise.
SARVAM_LANGUAGE_ENGLISH=en-IN
SARVAM_LANGUAGE_HINDI=hi-IN
SARVAM_LANGUAGE_HINGLISH=hi-IN
# Default speaker per language. Speakers belong to ONE model: these are bulbul:v4-flash ids (<name>_<lang>_<style>,
# enhi = English-Hindi code-mixed). For bulbul:v3 use plain names such as shubh. Lowercase and case-sensitive.
SARVAM_SPEAKER_ENGLISH=dev_en_conversational
SARVAM_SPEAKER_HINDI=kavya_hi_conversational
SARVAM_SPEAKER_HINGLISH=simran_enhi_customer
# SARVAM_TTS_VOICES=ishita_enhi_companion,shubh_enhi_companion   # extra speakers a client may request (allowlist)
SARVAM_TTS_SAMPLE_RATE=24000                       # 8000 | 16000 | 22050 | 24000 (streaming limit)
SARVAM_TTS_BITRATE=128k                            # 32k | 64k | 96k | 128k | 192k

# --- Voice turns (Phase 4, step 1): WS /voice/stream = text or audio in -> Gemini -> speech, sentence by sentence ---
# STT, Gemini and TTS keep their own limits above; these bound the whole pipeline. WebSocket sends reuse
# STT_SEND_TIMEOUT_SECONDS, waiting for a client message reuses STT_IDLE_TIMEOUT_SECONDS, origins reuse STT_ALLOWED_ORIGINS.
VOICE_MAX_CONCURRENT_TURNS=4                       # whole voice turns at once (each stage also has its own limit)
VOICE_TURN_TIMEOUT_SECONDS=90                      # from the user's text being known until the last audio is sent
VOICE_SENTENCE_QUEUE_SIZE=3                        # finished sentences waiting for TTS; when full, Gemini waits
VOICE_MAX_SENTENCE_CHARS=300                       # longest piece sent to TTS in one request (clamped to TTS_MAX_TEXT_CHARS)

# --- In-memory conversation sessions (lost on restart; not shared between workers) ---
SESSION_MAX_SESSIONS=1000        # least recently used idle session is evicted beyond this
SESSION_TTL_SECONDS=1800         # idle sessions expire after 30 minutes
SESSION_MAX_TURNS=20             # one turn = user message + assistant reply
SESSION_MAX_HISTORY_CHARS=12000
SESSION_LOCK_TIMEOUT_SECONDS=30  # how long a second request waits for a busy session before getting 409
