# Copy to .env and fill in. .env is git-ignored: never commit real secrets.

# --- Application ---
APP_NAME=AwaazAI Backend
ENVIRONMENT=development          # development | test | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL
# Comma-separated browser origins allowed to call the API (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database (PostgreSQL) ---
# Option 1: one URL (hosted providers like Neon/Supabase give you this)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Option 2: separate values
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=awaazai
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=awaazai

# --- Authentication ---
# REQUIRED for register/login (and for startup when ENVIRONMENT=production). At least 32 characters.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- VoiceAgent service (leave empty until it exists) ---
# VOICE_AGENT_BASE_URL=http://localhost:8001
VOICE_AGENT_TIMEOUT_SECONDS=5

# --- Rate limiting of register/login (stored in PostgreSQL; see README "Rate limiting") ---
RATE_LIMIT_ENABLED=true
# How many reverse proxies YOU control sit in front of the app. 0 = ignore X-Forwarded-For.
# Behind one proxy/load balancer set 1 (and run uvicorn with --no-proxy-headers).
TRUSTED_PROXY_COUNT=0
# RATE_LIMIT_REGISTER_MAX=10
# RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
# RATE_LIMIT_LOGIN_IP_MAX=20
# RATE_LIMIT_LOGIN_IP_WINDOW_SECONDS=300
# RATE_LIMIT_LOGIN_EMAIL_MAX=10
# RATE_LIMIT_LOGIN_EMAIL_WINDOW_SECONDS=900

# --- Database connection pool (per worker process; hosted poolers cap total clients) ---
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
