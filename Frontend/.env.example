# Copy to .env.local (git-ignored) only if VoiceAgent is NOT on the default address.
# Must be a loopback address: the page refuses any other host because VoiceAgent has no authentication yet.
# Never put an API key or secret in a VITE_ variable: everything starting with VITE_ is visible in the browser.
VITE_VOICE_AGENT_WS_URL=ws://127.0.0.1:8001/voice/stream

# Backend API (authentication, users, agents, voice status). Browser-visible: never put secrets in any VITE_ variable.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
